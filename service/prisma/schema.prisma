generator client {
  provider = "prisma-client-js"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}



// workspace

model Workspace {
  id              String                   @id
  slug            String                   @unique
  name            String
  ownerId         String
  ownerEmail      String

  status          WorkspaceStatus          @default(ACTIVE)
  plan            WorkspacePlan            @default(STARTER)
  limits          Json?

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  members         WorkspaceMember[]
  forms           Form[]

  @@index([ownerId])
}

enum WorkspaceStatus {
  ACTIVE
  INACTIVE  
  SUSPENDED
  ARCHIVED
}

enum WorkspacePlan {
  STARTER
  PLUS
  PRO
  PREMIUM
  ENTERPRISE
}



// workspace member

model WorkspaceMember {
  id              String                   @id
  workspaceId     String
  userId          String
  userEmail       String

  role            WorkspaceMembersRole     @default(MEMBER)
  status          MemberStatus             @default(ACTIVE)

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum WorkspaceMembersRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}



// form

model Form {
  id              String                   @id
  workspaceId     String
  userId          String
  name            String
  slug            String                   
  status          FormStatus               @default(DRAFT)
  title           String?
  description     String?
  theme           FormTheme                @default(DEFAULT)
  shareId         String                   @default("")              @unique                  
  version         Int                      @default(1)
  //TODO: other configs later

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formPage        FormPage[]
  formField       FormField[]
  submit          Submit[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, userId])
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormTheme {
  DEFAULT
  AMBER
  BLUE
  CYAN
  EMERALD
  FUCHSIA
  GREEN
  INDIGO
  LIME
  ORANGE
  PINK
  PURPLE
  RED
  ROSE
  SKY
  TEAL
  VIOLET
  YELLOW
}



// form page
   
model FormPage {
  id              String                   @id
  formId          String
  name            String?
  position        String                  

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt                   
 
  form            Form                     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formField       FormField[]

  @@unique([formId, position])
  @@index([formId])
}



// form field

model FormField {
  id                String                   @id
  formId            String
  formPageId        String                   
  config            Json
  position          String                   
  
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  
  formPage          FormPage                 @relation(fields: [formPageId], references: [id], onDelete: Cascade)
  form              Form                     @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissionAnswer  SubmissionAnswer[]

  @@unique([formPageId, position])
  @@index([formId])
}



// form submit

model Submit {
  id                 String                      @id
  formId             String
  status             FormSubmitStatus             @default(PARTIAL)
  
  ipAddress          String?
  device             String?
  os                 String?
  browser            String?
  
  completedAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  form               Form                        @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissionAnswer   SubmissionAnswer[]

  @@index([formId])
}

enum FormSubmitStatus {
  PARTIAL
  COMPLETED
}



// submission anns

model SubmissionAnswer {
  id                         String                       @id
  submitId                   String
  fieldId                    String
  valueText                  String?
  valueNumber                Float?
  valueBoolean               Boolean?
  valueJson                  Json? 

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  submit                     Submit                      @relation(fields: [submitId], references: [id], onDelete: Cascade)
  formField                  FormField                   @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submitId, fieldId])
  @@index([submitId])
  @@index([fieldId])
}