generator client {
  provider = "prisma-client-js"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}



// workspace

model Workspace {
  id              String                   @id
  slug            String                   @unique
  name            String
  ownerId         String
  ownerEmail      String

  status          WorkspaceStatus          @default(ACTIVE)
  plan            WorkspacePlan            @default(STARTER)
  limits          Json?

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  members         WorkspaceMember[]
  forms           Form[]

  @@index([ownerId])
}

enum WorkspaceStatus {
  ACTIVE
  INACTIVE  
  SUSPENDED
  DELETED
}

enum WorkspacePlan {
  STARTER
  PLUS
  PRO
  PREMIUM
  ENTERPRISE
}



// workspace member

model WorkspaceMember {
  id              String                   @id
  workspaceId     String
  userId          String
  userEmail       String

  role            WorkspaceMembersRole     @default(MEMBER)
  status          MemberStatus             @default(ACTIVE)

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum WorkspaceMembersRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}



// form

model Form {
  id              String                   @id
  workspaceId     String
  userId          String
  name            String
  slug            String                   
  status          FormStatus               @default(DRAFT)
  title           String?
  description     String?
  theme           FormTheme                @default(DEFAULT)
  //TODO: other configs later

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formPage        FormPage[]
  formField       FormField[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, userId])
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormTheme {
  DEFAULT
  AMBER
  BLUE
  CYAN
  EMERALD
  FUCHSIA
  GREEN
  INDIGO
  LIME
  ORANGE
  PINK
  PURPLE
  RED
  ROSE
  SKY
  TEAL
  VIOLET
  YELLOW
}




// form page
   
model FormPage {
  id              String                   @id
  formId          String
  name            String?
  position        String                  

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt                   
 
  form            Form                     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formField       FormField[]

  @@unique([formId, position])
  @@index([formId])
}



// form field

model FormField {
  id              String                   @id
  formId          String
  formPageId      String                   
  config          Json
  position        String                   

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  formPage        FormPage                 @relation(fields: [formPageId], references: [id], onDelete: Cascade)
  form            Form                     @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  @@unique([formPageId, position])
  @@index([formId])
}